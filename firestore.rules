rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // IMPORTANTE: estas reglas son solo para una app personal/prototipo.
    // Sin Firebase Authentication, cualquier persona que conozca el proyecto
    // podría leer/escribir datos si la app está publicada.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}